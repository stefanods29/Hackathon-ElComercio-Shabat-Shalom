{
  "name": "@vecinal/backend",
  "version": "0.1.0",
  "description": "Backend de la app vecinal: monolito modular en NestJS 12 (Fase 0 · cimientos)",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/ scripts/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "graph": "tsx scripts/generate-graph.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "dev:keys": "tsx scripts/generate-keys.ts",
    "sync:validate": "tsx scripts/validate-sync-config.ts ../infra/powersync/sync-config.yaml",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run boundaries && npm run sync:validate && npm run test && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "jose": "^6.2.15",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.0",
    "@powersync/service-sync-rules": "^0.45.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dependency-cruiser": "^18.7.2",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
