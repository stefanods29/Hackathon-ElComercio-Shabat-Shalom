# Crea tu .env con `npm run dev:keys` (lo genera con una clave nueva). Nunca subas .env.
NODE_ENV=development
PORT=3000

# Base de datos de infra/docker-compose.yml
DATABASE_URL=postgres://vecinal:vecinal@localhost:5432/vecinal

# Tokens JWT ES256. La clave privada la genera `npm run dev:keys`.
JWT_ISSUER=vecinal-api
JWT_KID=dev-1
JWT_PRIVATE_KEY_PEM=
JWT_ACCESS_MINUTES=15
JWT_SYNC_MINUTES=10

# URL del servicio de PowerSync que la API entrega al celular (desde el emulador Android: http://10.0.2.2:8080)
POWERSYNC_URL=http://localhost:8080

# Solo desarrollo: POST /v1/dev/sesiones entra con el teléfono de un vecino sembrado.
ENABLE_DEV_SESSION=true

# Horas que se guarda la respuesta de cada Idempotency-Key (7 días)
IDEMPOTENCY_RETENTION_HOURS=168

# Avisos: fake solo en desarrollo/pruebas. Producción requiere fcm y cuenta de servicio privada.
NOTIFICATION_DRIVER=fake
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Fotos privadas (Fase 1 C). disabled por defecto; fake solo en pruebas.
MEDIA_DRIVER=disabled
MEDIA_BUCKET=
MEDIA_REGION=auto
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_FORCE_PATH_STYLE=false

# Monitoreo opcional. No se exporta contenido de vecinos.
APP_ENVIRONMENT=dev
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
# Solo Cloud Run: instancia proyecto:region:nombre; conexión TLS con ADC y red privada.
CLOUD_SQL_INSTANCE=
