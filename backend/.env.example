# Crea tu .env con `npm run dev:keys` (lo genera con una clave nueva). Nunca subas .env.
NODE_ENV=development
PORT=3000

# Base de datos de infra/docker-compose.yml
DATABASE_URL=postgres://vecinal:vecinal@localhost:5432/vecinal

# Tokens JWT ES256. La clave privada la genera `npm run dev:keys`.
JWT_ISSUER=vecinal-api
JWT_KID=dev-1
JWT_PRIVATE_KEY_PEM=
# Entre 1 y 15 minutos: el acceso ya emitido conserva su vigencia tras revocar la sesión.
JWT_ACCESS_MINUTES=15
JWT_SYNC_MINUTES=10

# URL del servicio de PowerSync que la API entrega al celular (desde el emulador Android: http://10.0.2.2:8080)
POWERSYNC_URL=http://localhost:8080

# Solo desarrollo: POST /v1/dev/sesiones entra con el teléfono de un vecino sembrado.
ENABLE_DEV_SESSION=true

# Horas que se guarda la respuesta de cada Idempotency-Key (7 días)
IDEMPOTENCY_RETENTION_HOURS=168

# Publicaciones nuevas por autor en una ventana móvil de 24 horas; los reintentos no cuentan.
MAX_POSTS_PER_DAY=10

# Reseñas: edad mínima de la cuenta y cuota por autor en una ventana móvil de 24 horas.
MIN_ACCOUNT_AGE_HOURS_TO_REVIEW=72
MAX_REVIEWS_PER_DAY=5

# Número de balanceadores confiables delante de la API; 0 desactiva trust proxy.
TRUST_PROXY_HOPS=0

# Códigos OTP. `npm run dev:keys` genera OTP_HASH_SECRET; nunca lo subas al repositorio.
# Proveedores: fake (desarrollo), firebase (la app verifica con Firebase) o twilio.
# El proveedor fake está prohibido en producción.
OTP_PROVIDER=fake
OTP_HASH_SECRET=
OTP_TTL_MINUTES=5
OTP_MAX_REQUESTS_PER_PHONE=3
OTP_MAX_REQUESTS_PER_IP=20
OTP_MAX_ATTEMPTS=5
# Fallos de verificación por IP en una ventana de OTP_LOCK_MINUTES, entre todos los teléfonos.
OTP_MAX_ATTEMPTS_PER_IP=20
# Duración de la ventana de fallos y del bloqueo, contado desde el fallo que alcanza el límite.
OTP_LOCK_MINUTES=15

# Refresh tokens opacos. `dev:keys` genera un secreto independiente de al menos 32 caracteres.
# Cambiar el secreto invalida todos los refresh tokens existentes.
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_DAYS=30

# Ingreso con Firebase (OTP_PROVIDER=firebase): la app verifica el teléfono con Firebase
# Authentication y la API solo valida el token. Basta el ID del proyecto: no hay secreto.
# Si está definida, POST /v1/auth/firebase también funciona con los otros proveedores.
FIREBASE_PROJECT_ID=

# Obligatorias únicamente cuando OTP_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# Cola durable. Solo las pruebas pueden elegir memory.
JOB_QUEUE_DRIVER=pgboss

# Avisos: fake solo en desarrollo/pruebas. Producción requiere fcm y cuenta de servicio privada.
NOTIFICATION_DRIVER=fake
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Fotos privadas (Fase 1 C). disabled por defecto; fake solo en pruebas.
MEDIA_DRIVER=disabled
MEDIA_BUCKET=
MEDIA_REGION=auto
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_FORCE_PATH_STYLE=false

# Monitoreo opcional. No se exporta contenido de vecinos.
APP_ENVIRONMENT=dev
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
# Solo Cloud Run: instancia proyecto:region:nombre; conexión TLS con ADC y red privada.
CLOUD_SQL_INSTANCE=
