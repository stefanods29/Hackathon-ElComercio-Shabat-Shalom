{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Directorio de emergencia de un distrito",
  "description": "Archivo público que la CDN sirve en /emergencia/<archivo> y que la app guarda para abrirlo sin señal (Fase 1, Lote A, parte 2). Solo información institucional: nunca datos de vecinos. El índice que lo acompaña está en $defs/indice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "distrito", "generadoEn", "entradas"],
  "properties": {
    "version": {
      "description": "Sube en cada cambio del archivo.",
      "type": "integer",
      "minimum": 1
    },
    "distrito": { "type": "string", "minLength": 2, "maxLength": 80 },
    "generadoEn": { "type": "string", "format": "date-time" },
    "entradas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/entrada" }
    }
  },
  "$defs": {
    "entrada": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tipo", "nombre", "fuente", "verificadoEn"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,60}$" },
        "tipo": {
          "enum": ["numero", "punto_de_encuentro", "centro_de_salud", "albergue"]
        },
        "nombre": { "type": "string", "minLength": 2, "maxLength": 120 },
        "telefono": {
          "description": "Número institucional para marcar desde el celular.",
          "type": "string",
          "pattern": "^\\+?[0-9][0-9 ]{1,18}[0-9]$"
        },
        "ubicacion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "direccion": { "type": "string", "minLength": 2, "maxLength": 200 },
        "descripcion": { "type": "string", "minLength": 2, "maxLength": 300 },
        "fuente": {
          "description": "Quién publicó el dato: una institución o un aliado, con su página si la tiene.",
          "type": "object",
          "additionalProperties": false,
          "required": ["nombre"],
          "properties": {
            "nombre": { "type": "string", "minLength": 2, "maxLength": 120 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        },
        "verificadoEn": {
          "description": "Último día en que el curador comprobó el dato en su fuente.",
          "type": "string",
          "format": "date"
        }
      },
      "if": { "properties": { "tipo": { "const": "numero" } } },
      "then": { "required": ["telefono"] },
      "else": { "required": ["ubicacion"] }
    },
    "indice": {
      "title": "Índice de los directorios de emergencia",
      "description": "Archivo /emergencia/indice.json: la app busca el distrito de su zona y comprueba el hash antes de guardar.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generadoEn", "distritos"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "generadoEn": { "type": "string", "format": "date-time" },
        "distritos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "archivo", "version", "sha256", "bytes", "zonas"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]{2,60}$" },
              "archivo": { "type": "string", "pattern": "^[a-z0-9-]{2,60}\\.json$" },
              "version": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
              "zonas": {
                "description": "Ids de las zonas (identidad.zonas) que usan este archivo.",
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      }
    }
  }
}
