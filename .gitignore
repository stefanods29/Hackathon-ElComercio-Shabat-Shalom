# Secretos: nunca se suben (variables documentadas en backend/.env.example)
.env
.env.*
!.env.example

# Dependencias y salidas de compilación
node_modules/
dist/
coverage/
backend/*.log
infra/cloud/*.log
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tsbuildinfo

# Credenciales sintéticas de carga y resultados locales de k6.
*.load-tokens.json
*.load-summary.json

# Scripts y ajustes locales de cada persona (rutas de su PC, datos de su proyecto Firebase)
*.local.cmd
*.local.sh
*.local.json

# Sistema operativo y editores
.DS_Store
Thumbs.db
*.swp

# Mapas del Lote C: se regeneran con infra/cdn/scripts/ (no subir binarios pesados).
infra/cdn/.tools/
infra/cdn/.cache/
infra/cdn/publico/*.pmtiles
infra/cdn/publico/distrito.manifest.json
infra/cdn/publico/fuentes/
infra/cdn/publico/sprites/
infra/cdn/publico/vendor/
