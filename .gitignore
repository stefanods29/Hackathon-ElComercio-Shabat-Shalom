# Secretos: nunca se suben (variables documentadas en backend/.env.example)
.env
.env.*
!.env.example

# Dependencias y salidas de compilación
node_modules/
dist/
coverage/
*.tsbuildinfo

# Scripts locales de cada persona (rutas de su PC)
*.local.cmd
*.local.sh

# Sistema operativo y editores
.DS_Store
Thumbs.db
*.swp

# Mapas del Lote C: se regeneran con infra/cdn/scripts/ (no subir binarios pesados).
infra/cdn/.tools/
infra/cdn/.cache/
infra/cdn/publico/*.pmtiles
infra/cdn/publico/distrito.manifest.json
infra/cdn/publico/fuentes/
infra/cdn/publico/sprites/
infra/cdn/publico/vendor/
